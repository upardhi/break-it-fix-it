# Copy this file to .env and paste your key.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Student challenge: this repo is public, so pick your own secret staff coupon
# on the day (students who read the code will only know the default STAFF-90).
# CHALLENGE_SECRET_COUPON=STAFF-7731

# Optional: pick a different Gemini model
# SHOPBUDDY_MODEL=gemini-2.5-flash
